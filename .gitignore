.DS_Store
__pycache__/
*.pyc

# Build stamps - local mtime bookkeeping for make, not content
.stamps/

# Source data: ~900 MB, re-downloadable with ./setup.sh, and fingerprinted in
# fetch/expected.json so a re-fetch can be checked against the published run.
data/raw/

# Intermediate database: rebuilt from data/raw/ in ~80s, and every rebuild is a
# byte-different blob.
data/*.duckdb
data/*.duckdb.wal
data/_test.duckdb

# Vite app: dependencies and build output.
site/node_modules/
site/dist/

# Basemap: a 19 MB Portland slice of the Protomaps planet build, regenerated by
# `make basemap` (site/scripts/basemap.sh) and by CI. The site degrades to a
# flat ground with the city boundary when it is absent, so this is safe to
# leave out of the tree.
site/public/basemap.pmtiles
